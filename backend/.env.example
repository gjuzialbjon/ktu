# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API (the Expo web app runs on 8081)
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Postgres (Neon, EU region). Leave empty in development to use the embedded
# PGlite database in ./.data/pglite: no account or Docker needed.
DATABASE_URL=

# Added in step 2 (sign-in)
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
